# DUYO Backend — environment example
# Copy to .env and fill with real values. NEVER commit .env.

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://duyo:duyo_dev_password@localhost:5432/duyo

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# AI providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...  # Google AI Studio — https://aistudio.google.com/app/apikey

# Crisis detection
CRISIS_CLASSIFIER_MODEL_PATH=./models/crisis-bert-v1
CRISIS_THRESHOLD_YELLOW=0.70
CRISIS_THRESHOLD_ORANGE=0.85
CRISIS_THRESHOLD_RED=0.95

# SMS (Eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=DUYO

# Payment
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Voice
YANDEX_SPEECHKIT_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Observability
SENTRY_DSN=
