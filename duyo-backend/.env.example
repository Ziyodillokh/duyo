# DUYO Backend — environment example
# Copy to .env and fill with real values. NEVER commit .env.

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://duyo:duyo_dev_password@localhost:5432/duyo

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
# A refresh token is the whole session. Sessions can now be ended server-side
# (POST /v1/auth/logout bumps users.token_version), but the window before
# anyone notices a leak should still be short — 14, not the old 30.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# Rate limits on the two endpoints that answer to anyone (Redis-backed).
# Per SOURCE, not per phone: the per-phone OTP cap bounds how often one number
# is messaged, not how many numbers one script may walk.
OTP_RATE_LIMIT_PER_IP_PER_HOUR=20
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# AI providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...  # Google AI Studio — https://aistudio.google.com/app/apikey

# Crisis detection
CRISIS_CLASSIFIER_MODEL_PATH=./models/crisis-bert-v1
CRISIS_THRESHOLD_YELLOW=0.70
CRISIS_THRESHOLD_ORANGE=0.85
CRISIS_THRESHOLD_RED=0.95

# SMS (Eskiz.uz)
# ESKIZ_PASSWORD is the SMS-GATEWAY secret key from the cabinet's "SMS shlyuz"
# page — NOT the password you log into eskiz.uz with; that one is rejected.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Eskiz's shared system sender. An alphanumeric name (e.g. "DUYO") must be
# registered and approved in the cabinet first, or every send is rejected.
ESKIZ_FROM=4546
# true = log SMS instead of sending. Fine in dev; the app refuses to boot
# with this on (or with the credentials above blank) when APP_ENV=production,
# because the stub reports success while delivering nothing.
SMS_STUB_ENABLED=true

# Payment
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Voice
YANDEX_SPEECHKIT_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Observability
SENTRY_DSN=
