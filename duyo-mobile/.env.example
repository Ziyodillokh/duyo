# DUYO Mobile — environment example
# Loaded via Expo (EXPO_PUBLIC_* vars are inlined at build time)

# API (Bosqich B Faza 0 — staging endpoint)
# For 5-family beta switch to https://api.duyo.uz/v1 + wss://api.duyo.uz/v1/chat/voice
EXPO_PUBLIC_API_BASE_URL=https://api-staging.duyo.uz/v1
EXPO_PUBLIC_WS_BASE_URL=wss://api-staging.duyo.uz/v1/chat/voice

# Sentry (Phase 5+)
SENTRY_DSN=

# Push (Phase 5+)
FCM_SENDER_ID=
