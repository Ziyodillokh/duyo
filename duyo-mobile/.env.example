# DUYO Mobile — environment example
# Loaded via Expo (EXPO_PUBLIC_* vars are inlined at build time)

# API — production (live for the 5-family beta)
EXPO_PUBLIC_API_BASE_URL=https://api.duyo.uz/v1
EXPO_PUBLIC_WS_BASE_URL=wss://api.duyo.uz/v1/chat/voice

# Sentry (Phase 5+)
SENTRY_DSN=

# Push (Phase 5+)
FCM_SENDER_ID=
