{
  "expo": {
    "name": "DUYO",
    "slug": "duyo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/duyo-icon.png",
    "scheme": "duyomobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/duyo-icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DUYO sizdan tovush yozish uchun mikrofonga ruxsat so'raydi. Tovush faqat AI suhbat uchun ishlatiladi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/duyo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/duyo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/duyo-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
